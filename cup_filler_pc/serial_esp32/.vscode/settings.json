{
  "// ghi chú": "Cấu hình gợi ý cho VS Code + PlatformIO của firmware máy rót nước (mở thư mục cup_filler_pc/serial_esp32)",
  "files.associations": {
    "*.ino": "cpp",
    "*.h": "cpp"
  },
  "files.exclude": {
    "**/.pio": true,
    "**/.pio/**": true
  },
  "editor.tabSize": 2,
  "editor.rulers": [
    100
  ],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "C_Cpp.default.cppStandard": "c++11",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/../firmware/esp32_cup_filler",
    "${workspaceFolder}/../firmware/host_test"
  ],
  "terminal.integrated.cwd": "${workspaceFolder}"
}
